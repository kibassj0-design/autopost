# الذكاء الاصطناعي: يكفي واحد منهما.
# Gemini مجاني: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# مفاتيح مجانية إضافية (اختيارية): تُستخدم تلقائيا عند انتهاء حصة ما قبلها.
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Claude مدفوع وأدق: https://console.anthropic.com
ANTHROPIC_API_KEY=

# YouTube — OAuth client (Google Cloud Console > Credentials > Desktop app)
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Instagram — حساب Business/Creator، توكن طويل الأمد مع صلاحية instagram_content_publish
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.facebook.com (Facebook Login) او graph.instagram.com (Instagram Login)
IG_GRAPH_HOST=graph.facebook.com

# TikTok — developers.tiktok.com (Content Posting API, scopes: video.publish, video.list)
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_REDIRECT_URI=
# Optional: add video.list (if it is enabled in your TikTok app) to track views
# TT_SCOPES=user.info.basic,video.publish,video.list
